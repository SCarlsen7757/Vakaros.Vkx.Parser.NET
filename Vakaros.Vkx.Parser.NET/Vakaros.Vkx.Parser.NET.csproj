<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- NuGet packaging -->
    <PackageId>Vakaros.Vkx.Parser.NET</PackageId>
    <Description>Binary parser for Vakaros VKX log files. Decodes all telemetry records (position, wind, depth, speed-through-water, load, temperature, race timer events, and more) into strongly-typed .NET objects.</Description>
    <Authors>SCarlsen7757</Authors>
    <Copyright>Copyright © SCarlsen7757</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>vkx-parser-logo.png</PackageIcon>
    <PackageProjectUrl>https://github.com/SCarlsen7757/Vakaros.Vkx.Parser.NET</PackageProjectUrl>
    <PackageTags>vakaros;vkx;sailing;telemetry;parser</PackageTags>
    <RepositoryUrl>https://github.com/SCarlsen7757/Vakaros.Vkx.Parser.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <!-- Raw as-recorded values are internal; tests verify them directly -->
    <InternalsVisibleTo Include="Vakaros.Vkx.Parser.NET.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pack the root README and logo into the NuGet package -->
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\vkx-parser-logo.png" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
